<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-body p-5">
          <h2 class="card-title mb-4">✈️ Plan Your Next Adventure</h2>
          <%= form_with(model: @trip, local:true, class: "form") do |form| %>
            <div class="mb-3">
              <%= form.label :name, "Trip Name", class: "form-label fw-bold" %>
              <%= form.text_field :name, class: "form-control form-control-lg", placeholder: "e.g. Summer in Paris" %>
            </div>
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :start_date, "Start Date", class: "form-label fw-bold" %>
                  <%= form.date_field :start_date, class: "form-control form-control-lg" %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :end_date, "End Date", class: "form-label fw-bold" %>
                  <%= form.date_field :end_date, class: "form-control form-control-lg" %>
                </div>
              </div>
            </div>
            <div class="mb-4">
              <%= form.label :notes, "Notes & Ideas", class: "form-label fw-bold" %>
              <%= form.text_area :notes, class: "form-control form-control-lg", rows: 5,
                                 placeholder: "What do you want to do? Any must-see places?" %>
            </div>
            <div class="mb-4">
              <%= form.label :photo, "Cover Photo", class: "form-label fw-bold" %>
              <%= form.file_field :photo, class: "form-control form-control-lg", accept: "image/*" %>
            </div>
            <div class="d-flex gap-2">
              <%= form.submit "Create Trip", class: "btn btn-success btn-lg flex-grow-1" %>
              <%= link_to "Cancel", trips_path, class: "btn btn-outline-secondary btn-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>