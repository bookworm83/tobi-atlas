<h1>Edit Trip</h1>
<%= form_with(model: @trip, local: true) do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :start_date %>
    <%= form.date_field :start_date %>
  </div>
  <div>
    <%= form.label :end_date %>
    <%= form.date_field :end_date %>
  </div>
  <div>
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>
  <div>
    <%= form.label :photo %>
    <%= form.file_field :photo, accept: "image/*" %>
  </div>
  <div>
    <%= form.submit "Update Trip" %>
  </div>
<% end %>