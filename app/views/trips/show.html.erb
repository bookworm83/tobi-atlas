<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-body p-5">
          <h2 class="cart-title mb-4"><%= @trip.name %></h2>

          <% if @trip.photo.attached? %>
            <div class="mb-4">
              <%= image_tag @trip.photo, class: "img-fluid rounded" %>
            </div>
          <% end %>

          <div class="row mb-4">
            <div class="col-md-6">
              <p class="text-muted">Start Date</p>
              <p class="fs-5"><%= @trip.start_date&.strftime("%d, %B %Y") %></p>
            </div>
            <div class="col-md-6">
              <p class="text-muted">End Date</p>
              <p class="fs-5"><%= @trip.end_date&.strftime("%d, %B %Y") %></p>
            </div>
          </div>
          <div class="mb-4">
            <p class="text-muted">📝 Notes</p>
            <p class="fs-5"><%= @trip.notes %></p>
          </div>
          <div class="d-flex gap-2">
            <%= link_to "Edit", edit_trip_path(@trip), class: "btn btn-warning btn-lg" %>
            <%= button_to "Delete", trip_path(@trip), method: :delete,
                          onclick: "return confirm('Are you sure you want to delete this trip?');",
                          class: "btn btn-danger btn-lg" %>
          </div>
          <div class="mt-4">
            <%= link_to "← Back to Trips",trips_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>