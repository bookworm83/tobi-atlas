<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-body p-5">
          <h2 class="card-title text-center mb-4">Login to Tobi Atlas</h2>
          <% if alert %>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
              <%= alert %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>
          <%= form_with url: login_path, local:true, class: "form" do |form| %>
            <div class="mb-3">
              <%= form.label :email, class: "form-label" %>
              <%= form.email_field :email, class: "form-control", placeholder: "Enter your email" %>
            </div>
            <div class="mb-3">
              <%= form.label :password, class: "form-label" %>
              <%= form.password_field :password, class: "form-control", placeholder: "Enter your password" %>
            </div>
            <div class="d-grid gap-2">
              <%= form.submit "Login", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
          <p class="text-center mt-3">
            Don't have an account? <%= link_to "Sign up", new_user_path %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>