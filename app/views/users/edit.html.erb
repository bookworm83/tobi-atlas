<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-body p-5">
          <h2 class="card-title text-center mb-4">Update Your Profile</h2>
          <% if @user.errors.any? %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <h5 class="alert-heading">Errors:</h5>
              <ul class="mb-0">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%=message %></li>
                <% end %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>
          <%= form_with(model: @user, url: profile_path, method: :patch, local:true) do |form| %>
            <div class="mb-3">
              <%= form.label :bio, class: "form-label" %>
              <%= form.text_area :bio, class: "form-control form-control-lg", maxlength: User::MAX_BIO_LENGTH,
                                 placeholder: "Tell people about yourself." %>
            </div>
            <button class="btn btn-outline-secondary mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#passwordFields">
              Change Password
            </button>
            <div class="collapse" id="passwordFields">
              <div class="mb-3">
                <%= form.label :current_password, class: "form-label" %>
                <%= form.password_field :current_password, class: "form-control", placeholder: "Enter your current password" %>
              </div>
              <div class="mb-3">
                <%= form.label :password, class: "form-label" %>
                <%= form.password_field :password, class: "form-control", placeholder: "Choose a new password" %>
              </div>
              <div class="mb-3">
                <%= form.label :password_confirmation, class: "form-label" %>
                <%= form.password_field :password_confirmation, class: "form-control", placeholder: "Confirm your new password" %>
              </div>
            </div>
            <div class="d-grid gap-2">
              <%= form.submit "Update Profile", class: "btn btn-success btn-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>